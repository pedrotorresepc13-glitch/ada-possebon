# =============================================================================
# ADA POSSEBON — variáveis de ambiente (copie para .env; NUNCA versione .env)
# Valores entre <> devem ser preenchidos no servidor. Segredos ficam só no servidor/cofre.
# =============================================================================

# development | test | production
ADA_ENV=development
ADA_HOST=127.0.0.1
ADA_PORT=4800
# Caminho público atrás do proxy (https://<dominio-possebon>/ada/)
ADA_BASE_PATH=/ada
# Raiz do release (produção/systemd). Em desenvolvimento é detectada automaticamente.
# ADA_ROOT=/opt/ada/current

# Origens confiáveis para requisições mutáveis (checagem de Origin) — separadas por espaço
ADA_ALLOWED_ORIGINS=http://127.0.0.1:4800 http://localhost:4800 http://localhost:5173
# Quem pode incorporar a ADA em iframe (CSP frame-ancestors). Produção: somente a origem oficial do POSSEBON Web.
ADA_FRAME_ANCESTORS="'self'"
# ADA_FRAME_ANCESTORS="'self' https://<dominio-possebon>"

# --- Banco ---------------------------------------------------------------------
# Produção: PostgreSQL 15 com usuário de privilégio mínimo (ver deploy/sql/roles.sql)
# DATABASE_URL=postgres://ada_app:<senha>@127.0.0.1:5432/<banco>?application_name=ada
# Desenvolvimento sem servidor PostgreSQL: PGlite (PostgreSQL em WASM) em .data/pglite
ADA_DB_DRIVER=pglite
ADA_PGLITE_DIR=.data/pglite

# --- Criptografia (credenciais de integrações e conteúdo privado) ---------------
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Obrigatória em produção. Guarde em cofre; a perda impede ler conversas/credenciais cifradas.
# ADA_ENCRYPTION_KEY=<base64-32-bytes>

# --- Sessão ---------------------------------------------------------------------
ADA_SESSION_TTL_HOURS=12
ADA_SESSION_IDLE_MINUTES=60
# Lax quando a ADA está no MESMO site do POSSEBON (recomendado: /ada/ no mesmo domínio).
# None (exige HTTPS) somente se for outro site — sujeito ao bloqueio de cookies de terceiros dos navegadores.
ADA_COOKIE_SAMESITE=Lax
# ADA_COOKIE_SECURE=true

# --- SSO com o POSSEBON Web (ticket de troca, uso único, ≤ 60 s) ------------------
ADA_SSO_ISSUER=possebon-web
ADA_SSO_AUDIENCE=ada-possebon
ADA_SSO_MAX_AGE_SECONDS=60
# Um dos dois (segredo compartilhado ≥ 32 chars OU chave pública Ed25519 PEM):
# ADA_SSO_HS256_SECRET=<segredo-compartilhado-com-o-possebon>
# ADA_SSO_ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Endpoint servidor-servidor de identidade/permissões (PROPOSTO — ver docs/ADA_INTEGRACAO_POSSEBON.md)
# POSSEBON_IDENTITY_URL=https://<dominio-possebon>/api/ada/v1/identity
# POSSEBON_SERVICE_TOKEN=<token-técnico-exclusivo-da-ada>

# Programas (system_program.controller) do POSSEBON que definem papéis na ADA
ADA_ADMIN_PROGRAM=AdaAdministracao
ADA_MANAGER_PROGRAM=AdaGestor
ADA_CROSSUNIT_PROGRAM=AdaConsolidarUnidades
# Opcional: exigir um programa para acessar a ADA
# ADA_ACCESS_PROGRAM=AdaAcesso
ADA_PERMISSION_TTL_SECONDS=300

# Canal servidor-servidor (revogação de sessão e eventos/outbox) — HMAC
# ADA_INTERNAL_HMAC_SECRET=<segredo-hmac>

# --- Desenvolvimento / demonstração (PROIBIDOS em produção) ----------------------
ADA_DEV_LOGIN=1
ADA_DEMO_DATA=1

# --- IA (somente no servidor) ----------------------------------------------------
# Sem chave+modelo a ADA usa o interpretador determinístico (sem IA generativa).
# OPENAI_API_KEY=<chave>
# ADA_OPENAI_MODEL=<modelo-escolhido-pela-administração>
ADA_OPENAI_BASE_URL=https://api.openai.com/v1
ADA_AI_TIMEOUT_MS=45000
ADA_AI_MAX_OUTPUT_TOKENS=1500
ADA_AI_DAILY_REQUESTS_PER_USER=200
ADA_CHAT_PER_MINUTE=20

# --- Diversos --------------------------------------------------------------------
ADA_CACHE_TTL_SECONDS=120
ADA_UPLOAD_MAX_MB=20
ADA_LOG_LEVEL=info
ADA_WORKER_INTERVAL_MS=15000
ADA_WORKER_HEALTH_PORT=4801
