{
  "name": "@ada/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./cycle": "./src/cycle.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.mjs",
    "build": "node build.mjs",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts up",
    "migrate:down": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts down",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/cli/seed-demo.ts",
    "dev:ticket": "tsx --env-file-if-exists=../../.env src/cli/dev-ticket.ts",
    "openapi": "tsx src/cli/openapi.ts",
    "knowledge:bootstrap": "tsx --env-file-if-exists=../../.env src/cli/bootstrap-public-knowledge.ts"
  },
  "dependencies": {
    "@ada/contracts": "0.1.0",
    "@ada/domain": "0.1.0",
    "@electric-sql/pglite": "^0.5.12",
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15"
  }
}
